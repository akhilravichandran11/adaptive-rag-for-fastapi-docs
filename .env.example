# Copy this file to .env and fill in your values. Do not commit .env.
# Only the OpenAI settings are used by the current pipeline; the rest are
# placeholders for planned stages.

# --- OpenAI (required by the curation pipeline) ---
OPENAI_API_KEY=

# Optional OpenAI overrides (sensible defaults are used if unset)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_RETRIES=3
# OPENAI_TIMEOUT=60

# --- Planned stages (not yet wired) ---
# Google Gemini (embeddings / generation)
# GOOGLE_API_KEY=

# Qdrant vector store
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
