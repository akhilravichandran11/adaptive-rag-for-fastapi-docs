# Copy this file to .env and fill in your values. Do not commit .env.

# --- Application ---
APP_NAME=AKR - adaptive-rag-for-fastapi-docs

DEBUG=true
AKR_DEBUG=false
LOG_LEVEL=INFO



# -------------------------------------------
# Qdrant Cloud Configuration
# -------------------------------------------
# from: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
COLLECTION_NAME=
METADATA_COLLECTION=

# -------------------------------------------
# Embedding Configuration (FastEmbed)
# -------------------------------------------
# Runs locally, no API key needed
FASTEMBED_MODEL=BAAI/bge-large-en-v1.5
FASTEMBED_CACHE_PATH=
EMBEDDING_DIMENSION=1024
FASTEMBED_BATCH_SIZE=32
NLTK_DATA=

# -------------------------------------------
# LLM Configuration (Google Gemini)
# -------------------------------------------
# from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# -- Gemini LLM Models --

# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_MODEL=gemini-2.5-flash


# -------------------------------------------
# OpenAI Configuration (for data curation)
# -------------------------------------------
# from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MAX_RETRIES=5
OPENAI_TIMEOUT=240.0
OPENAI_LOG=info
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------
# Document Configuration
# -------------------------------------------
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# -------------------------------------------
# Retrieval Settings
# -------------------------------------------
RETRIEVAL_TOP_K=5
MAX_TOKENS=1000
TEMPERATURE=0.1

# -------------------------------------------
# Embedding Configuration (Voyage AI)
# -------------------------------------------
# --- Voyage AI ---
# from: https://dash.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-lite
VOYAGE_DIMENSION=2048


# --- Redis Cloud ---
# from: https://cloud.redis.io/
REDIS_HOST=
REDIS_PORT=15421
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_SSL=false


# --- Sparse Embeddings ---
SPARSE_MODEL=Qdrant/bm25

# --- Semantic Cache ---
CACHE_EMBED_MODEL=voyage-4-lite
CACHE_EMBED_DIMENSION=2048
CACHE_DISTANCE_THRESHOLD=0.06
CACHE_TTL=86400

# --- Conversation Memory ---
CONVERSATION_WINDOW_SIZE=10
CONVERSATION_SESSION_TTL=86400

# --- Opik Observability ---
# from: https://www.comet.com/opik
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=



# --- Tavily ---

TAVILY_API_KEY=


# --- Github ---

GITHUB_TOKEN=
